# Copy to .env for LOCAL functions only. For hosted functions enter these
# names in Supabase Dashboard > Edge Functions > Secrets yourself.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=YOUR_SANDBOX_CLIENT_KEY
FRONTEND_URL=https://YOUR_WEBSITE_DOMAIN
# Comma-separated exact origins. Defaults to FRONTEND_URL when omitted.
ALLOWED_ORIGINS=https://YOUR_WEBSITE_DOMAIN
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Never copy service_role to the root frontend .env or public hosting.
